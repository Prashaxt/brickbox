{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true, "jsx": "react-jsx", "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true
  },
  "include": ["src", "test"]
}
